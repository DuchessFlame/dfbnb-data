      "label": "What build are you running?",
      "options": {
        "heavy":     { "label": "Heavy Guns",                 "ranged": true,  "weights": { "dmg_heavy": 1, "crit_heavy": 1, "dmg_unscoped": 0.8, "heavy_ammo": 0.4, "dmg_all": 1, "crit_dmg": 0.3, "dr": 0.6, "er": 0.5, "ap": 0.2 } },
        "rifle":     { "label": "Rifleman / Sniper (semi-auto & scoped rifles)", "ranged": true, "weights": { "dmg_scoped": 0.8, "dmg_all": 1, "crit_dmg": 0.4, "dr": 0.5, "er": 0.4, "ap": 0.3 } },
        "commando":  { "label": "Commando (auto rifles)",     "ranged": true,  "weights": { "dmg_unscoped": 0.8, "dmg_all": 1, "crit_dmg": 0.3, "dr": 0.5, "er": 0.4, "ap": 0.3 } },
        "pistol":    { "label": "Gunslinger (pistols)",       "ranged": true,  "weights": { "dmg_unscoped": 0.8, "dmg_all": 1, "crit_dmg": 0.4, "dr": 0.5, "er": 0.4, "ap": 0.4 } },
        "shotgun":   { "label": "Shotgunner",                 "ranged": true,  "weights": { "dmg_unscoped": 0.8, "dmg_all": 1, "crit_dmg": 0.3, "dr": 0.6, "er": 0.5, "ap": 0.3 } },
        "melee":     { "label": "Melee",                      "ranged": false, "goals": { "melee": 1 }, "fallback_add": { "str": 1, "dmg_melee": 1 }, "weights": { "dmg_melee_weapons": 1, "crit_melee": 1, "dmg_all": 1, "crit_dmg": 0.3, "dr": 0.6, "er": 0.5, "ap": 0.4 } },
        "unarmed":   { "label": "Unarmed",                    "ranged": false, "goals": { "unarmed": 1 }, "fallback_add": { "str": 1, "dmg_unarmed": 1, "dmg_melee": 0.6 }, "weights": { "dmg_all": 1, "crit_melee": 1, "crit_dmg": 0.3, "dr": 0.6, "er": 0.5, "ap": 0.4 } },
        "archer":    { "label": "Bows & Throwing (bows, knives, tomahawks)", "ranged": true, "skip": ["damage_type"], "prefer": { "alcohol": ["Wine"] }, "weights": { "dmg_all": 1, "crit_dmg": 0.5, "ap": 0.3, "dr": 0.4 } },
        "explosive": { "label": "Explosives",                 "ranged": true, "skip": ["damage_type"], "weights": { "dmg_explosive": 1, "dmg_all": 1, "crit_dmg": 0.2, "dr": 0.6, "er": 0.5, "fire_res": 0.3 } },
        "support":   { "label": "Support / Team Healer",      "ranged": true, "skip": ["damage_type"], "weights": { "stimpak_heal": 0.6, "cha": 1, "max_hp": 0.8, "dr": 0.6, "er": 0.5, "heal_rate": 0.6, "ap": 0.3, "end": 0.3 } }
      }
    },
    "playstyle": {
