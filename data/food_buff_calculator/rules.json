  "_damage_first_readme": "Chems and alcohol only get ONE slot each (dispel groups), so that slot goes to DAMAGE OUTPUT: buffs in the 'Damage' slot group count in full, everything else counts at non_damage_share. Carry Weight also counts in full when they say they struggle with carry weight (that is the only time Rad Ant Lager wins).",
  "damage_first": { "types": ["chem", "alcohol"], "non_damage_share": 0.25, "full_when_yes": { "carry": "carry" } },
  "penalties": {
    "rads_per_point": 0.01,
    "disease_chance_per_pct": 0.004,
    "addiction_per_pct": 0.003,
    "secondary_buff_share": 0.2,
    "debuff_share": 1.0
  }
