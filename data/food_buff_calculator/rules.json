{
  "_readme": [
    "SPECIAL buffs do NOT add perk card points - they only give the SPECIAL's own effects (AVIF descriptions, Oct 2026):",
    "  STR carry weight + melee damage | PER VATS accuracy | END total Health, sprint AP drain, disease resistance",
    "  CHA perk sharing, group quest rewards, barter (+ Inspirational XP) | INT hacking, crafted condition, XP gained, scrap",
    "  AGI VATS AP + sneak | LCK crit recharge rate, loot condition. So a SPECIAL is only weighted where that effect helps.",
    "",
    "HAND-KEPT rules for the Recommended Food Buff Calculator (/bnb/buffs/food/recommended-food-buff-calculator/).",
    "build_food_buff_calculator_json.py validates this file and copies it into dist/calculators/food_buff_calculator.json.",
    "Everything about the ITEMS (which buff, how big, how long, meat/veg, what stacks) comes from the game exports.",
    "Everything about WHY an item gets recommended lives here. To change a recommendation, change a weight here - not the page script.",
    "",
    "weights: 0 = never recommend that buff, 1 = core for the build. A buff only shows if its final weight is >= show_threshold.",
    "Final weight for a buff = build weight, then each answer's 'add' is added and each 'mult' is multiplied (adds first, then mults).",
    "'avoid' slots are hard-excluded: no item that GRANTS that buff is recommended at all (e.g. DR for berserkers).",
    "ref = what counts as one 'full strength' buff of that type; only used to rank different buffs against each other."
  ],
  "show_threshold": 0.3,
  "_display_order_readme": "Order the result cards and the stat list are shown in: SPECIAL first, then AP Regen, XP and the rest. Reorder freely.",
  "display_order": ["str", "per", "end", "cha", "int", "agi", "luck",
                    "ap_regen", "xp", "ap", "carry",
                    "dmg_all", "dmg_melee", "dmg_unarmed", "dmg_ballistic", "dmg_energy", "dmg_animals",
                    "crit_dmg", "sneak_attack", "vats_acc", "gun_acc",
                    "max_hp", "heal_rate", "dr", "er", "fire_res", "poison_res", "rad_res", "disease_res",
                    "move_speed", "invis"],
  "max_picks": { "food": 7, "chem": 4, "alcohol": 4 },
  "sessions": [
    { "key": "30", "label": "30 min", "minutes": 30, "food_min_duration_min": 30 },
    { "key": "60", "label": "60+ min", "minutes": 60, "food_min_duration_min": 60 }
  ],
  "slots": {
    "str":           { "label": "Strength",            "fmt": "+{v} Strength",              "ref": 3,   "group": "SPECIAL" },
    "per":           { "label": "Perception",          "fmt": "+{v} Perception",            "ref": 3,   "group": "SPECIAL" },
    "end":           { "label": "Endurance",           "fmt": "+{v} Endurance",             "ref": 3,   "group": "SPECIAL" },
    "cha":           { "label": "Charisma",            "fmt": "+{v} Charisma",              "ref": 3,   "group": "SPECIAL" },
    "int":           { "label": "Intelligence",        "fmt": "+{v} Intelligence",          "ref": 3,   "group": "SPECIAL" },
    "agi":           { "label": "Agility",             "fmt": "+{v} Agility",               "ref": 3,   "group": "SPECIAL" },
    "luck":          { "label": "Luck",                "fmt": "+{v} Luck",                  "ref": 3,   "group": "SPECIAL" },
    "dmg_all":       { "label": "Damage",              "fmt": "+{v}% Damage",               "ref": 25,  "group": "Damage" },
    "dmg_melee":     { "label": "Melee Damage",        "fmt": "+{v}% Melee Damage",         "ref": 30,  "group": "Damage" },
    "dmg_unarmed":   { "label": "Unarmed Damage",      "fmt": "+{v}% Unarmed Damage",       "ref": 50,  "group": "Damage" },
    "dmg_ballistic": { "label": "Ballistic Damage",    "fmt": "+{v}% Ballistic Damage",     "ref": 15,  "group": "Damage" },
    "dmg_energy":    { "label": "Energy Damage",       "fmt": "+{v}% Energy Damage",        "ref": 15,  "group": "Damage" },
    "dmg_animals":   { "label": "Damage vs Animals",   "fmt": "+{v}% Damage vs Animals",    "ref": 15,  "group": "Damage" },
    "crit_dmg":      { "label": "Critical Damage",     "fmt": "+{v}% Critical Damage",      "ref": 50,  "group": "Damage" },
    "sneak_attack":  { "label": "Sneak Attack Damage", "fmt": "+{v}% Sneak Attack Damage",  "ref": 15,  "group": "Damage" },
    "vats_acc":      { "label": "VATS Hit Chance",     "fmt": "+{v}% VATS Hit Chance",      "ref": 10,  "group": "Damage" },
    "gun_acc":       { "label": "Gun Accuracy",        "fmt": "+{v} Accuracy",              "ref": 33,  "group": "Damage" },
    "dr":            { "label": "Damage Resistance",   "fmt": "+{v} Damage Resistance",     "ref": 50,  "group": "Defence" },
