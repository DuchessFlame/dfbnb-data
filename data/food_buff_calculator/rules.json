    "poison_res":    { "label": "Poison Resistance",   "fmt": "+{v} Poison Resistance",     "ref": 50,  "group": "Defence" },
    "rad_res":       { "label": "Radiation Resistance","fmt": "+{v} Radiation Resistance",  "ref": 50,  "group": "Defence" },
    "disease_res":   { "label": "Disease Resistance",  "fmt": "+{v}% Disease Resistance",   "ref": 20,  "group": "Defence" },
    "max_hp":        { "label": "Max Health",          "fmt": "+{v} Max Health",            "ref": 40,  "group": "Defence" },
    "heal_rate":     { "label": "Health Regen",        "fmt": "+{v} Health Regen",          "ref": 0.25,"group": "Defence" },
    "ap":            { "label": "Action Points",       "fmt": "+{v} Action Points",         "ref": 30,  "group": "Utility" },
    "ap_regen":      { "label": "AP Regen",            "fmt": "+{v}% AP Regen",             "ref": 10,  "group": "Utility" },
    "carry":         { "label": "Carry Weight",        "fmt": "+{v} Carry Weight",          "ref": 30,  "group": "Utility" },
    "xp":            { "label": "XP",                  "fmt": "+{v}% XP",                   "ref": 5,   "group": "Utility" },
    "move_speed":    { "label": "Move Speed",          "fmt": "+{v}% Move Speed",           "ref": 20,  "group": "Utility" },
    "invis":         { "label": "Invisibility",        "fmt": "Invisible (Stealth Boy)",    "ref": 1,   "group": "Utility" }
  },
  "questions": {
    "build": {
      "label": "What build are you running?",
      "options": {
        "heavy":     { "label": "Heavy Guns",                 "ranged": true,  "weights": { "dmg_all": 1, "crit_dmg": 0.3, "dr": 0.6, "er": 0.5, "max_hp": 0.5, "ap": 0.2 } },
        "rifle":     { "label": "Rifleman / Sniper (semi-auto & scoped rifles)", "ranged": true, "weights": { "dmg_all": 1, "crit_dmg": 0.4, "dr": 0.5, "er": 0.4, "max_hp": 0.4, "ap": 0.3 } },
        "commando":  { "label": "Commando (auto rifles)",     "ranged": true,  "weights": { "dmg_all": 1, "crit_dmg": 0.3, "dr": 0.5, "er": 0.4, "max_hp": 0.4, "ap": 0.3 } },
        "pistol":    { "label": "Gunslinger (pistols)",       "ranged": true,  "weights": { "dmg_all": 1, "crit_dmg": 0.4, "dr": 0.5, "er": 0.4, "max_hp": 0.4, "ap": 0.4 } },
        "shotgun":   { "label": "Shotgunner",                 "ranged": true,  "weights": { "dmg_all": 1, "crit_dmg": 0.3, "dr": 0.6, "er": 0.5, "max_hp": 0.5, "ap": 0.3 } },
        "melee":     { "label": "Melee",                      "ranged": false, "weights": { "str": 1, "dmg_melee": 1, "dmg_all": 1, "crit_dmg": 0.3, "dr": 0.6, "er": 0.5, "max_hp": 0.5, "ap": 0.4 } },
        "unarmed":   { "label": "Unarmed",                    "ranged": false, "weights": { "str": 1, "dmg_unarmed": 1, "dmg_melee": 0.6, "dmg_all": 1, "crit_dmg": 0.3, "dr": 0.6, "er": 0.5, "max_hp": 0.5, "ap": 0.4 } },
        "archer":    { "label": "Bows & Throwing (bows, knives, tomahawks)", "ranged": true, "skip": ["damage_type"], "weights": { "dmg_all": 1, "crit_dmg": 0.5, "ap": 0.3, "dr": 0.4, "max_hp": 0.3 } },
        "explosive": { "label": "Explosives",                 "ranged": true, "skip": ["damage_type"], "weights": { "dmg_all": 1, "crit_dmg": 0.2, "dr": 0.6, "er": 0.5, "fire_res": 0.3, "max_hp": 0.5 } },
        "support":   { "label": "Support / Team Healer",      "ranged": true, "skip": ["damage_type"], "weights": { "cha": 1, "max_hp": 0.8, "dr": 0.6, "er": 0.5, "heal_rate": 0.6, "ap": 0.3, "end": 0.3 } }
      }
    },
    "damage_type": {
      "label": "What damage does your weapon do?",
      "only_if_ranged": true,
      "options": {
        "ballistic": { "label": "Ballistic (bullets)",     "add": { "dmg_ballistic": 0.9 } },
        "energy":    { "label": "Energy (laser / plasma)", "add": { "dmg_energy": 0.9 } },
        "mixed":     { "label": "Both / not sure",         "add": { "dmg_ballistic": 0.5, "dmg_energy": 0.5 } }
      }
    },
    "aim": {
      "label": "VATS or free aim?",
      "only_if_ranged": true,
      "options": {
        "vats": { "label": "VATS",                    "add": { "crit_dmg": 1.5, "vats_acc": 0.8, "ap": 0.5, "ap_regen": 0.7, "luck": 0.8, "agi": 0.6, "per": 0.6 },
                  "note": "VATS builds live on crits, so Critical Damage is weighted heavily (Overdrive over Psycho for the chem slot)." },
        "free": { "label": "Free aim / scope",        "add": { "gun_acc": 0.6 }, "mult": { "vats_acc": 0, "crit_dmg": 0.5, "ap_regen": 0.6 } }
      }
    },
    "sneaky": {
      "label": "Do you play sneaky?",
      "options": {
        "no":  { "label": "No" },
        "yes": { "label": "Yes", "add": { "agi": 1, "sneak_attack": 1.6, "invis": 0.4 } }
      }
    },
    "armour": {
      "label": "What armour do you wear?",
      "options": {
        "power": { "label": "Power Armour",                  "add": { "carry": 0.7 }, "mult": { "dr": 0.4, "er": 0.4, "rad_res": 0.2, "fire_res": 0.6, "poison_res": 0.6 },
                   "note": "Power Armour already gives big DR / ER and rad resistance, so those buffs drop down the list." },
        "body":  { "label": "Body armour",                   "add": { "dr": 0.1, "er": 0.1 } },
