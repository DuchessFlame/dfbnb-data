 "008AF90B": {
  "image_top": "/wp-content/uploads/guide-images/collectables/Brain-in-a-Jar-Locations/jars-1-32/brain-4-location.avif",
  "n_when_written": 4,
  "directions": "From the spawn above, face north-east and walk to the bottom of the stairs in front of you. Stand at the bottom of the stairs, face north-east again and walk forward, following the top of the cliff face around for a while until you see another camp site with a stargazer telescope on your right. Face north-west and walk over to the tree next to the cooking station. The Brain in a Jar is next to the sleeping bag in front of you.",
  "image_map": "/wp-content/uploads/guide-images/collectables/Brain-in-a-Jar-Locations/jars-1-32/brain-4-map.avif"
 },
 "008AF90C": {
  "image_top": "/wp-content/uploads/guide-images/collectables/Brain-in-a-Jar-Locations/jars-1-32/brain-3-location.avif",
  "directions": "Fast travel back to the Three Ponds map marker and face north-west. Jump, jetpack or whatever and keep going up the hill. This one is miles away, so keep walking straight and check you are staying north-west. You will climb up three rock faces until you reach a viewing platform at the top. Walk over to the platform and stand next to the blue water pump. Turn right and the Brain in a Jar is under the stairs, next to the wooden crates.",
  "n_when_written": 3,
  "image_map": "/wp-content/uploads/guide-images/collectables/Brain-in-a-Jar-Locations/jars-1-32/brain-3-map.avif"
 },
 "008AF90D": {
  "image_top": "/wp-content/uploads/guide-images/collectables/Brain-in-a-Jar-Locations/jars-1-32/brain-1-location.avif",
  "n_when_written": 1,
  "directions": "From the spawn in location, face south and walk forward until you see the sheet of wood laying on the ground in front of you, turn right and walk up to the top of the hill and stop next to the white tent. Face east and the Brain in a Jar is inside the yellow wooden crate at the bottom of the tree.",
  "image_map": "/wp-content/uploads/guide-images/collectables/Brain-in-a-Jar-Locations/jars-1-32/brain-1-map.avif"
 },
 "008AF90E": {
  "image_top": "/wp-content/uploads/guide-images/collectables/Brain-in-a-Jar-Locations/jars-1-32/brain-2-location.avif",
  "n_when_written": 2,
  "directions": "From the spawn above, stand on top of the yellow crate and face south. Walk forward and drop down so you are standing at the bottom of the waterfall. Face west and you will see the Brain in a Jar on the rock behind the waterfall.",
  "image_map": "/wp-content/uploads/guide-images/collectables/Brain-in-a-Jar-Locations/jars-1-32/brain-2-map.avif"
 },
 "008AF90F": {
  "image_map": "/wp-content/uploads/guide-images/collectables/Brain-in-a-Jar-Locations/jars-1-32/brain-5-map.avif",
  "image_top": "/wp-content/uploads/guide-images/collectables/Brain-in-a-Jar-Locations/jars-1-32/brain-5-location.avif",
  "directions": "From the spawn above, fast travel back to the Three Ponds map marker, face south and walk back over to where the Brain in a Jar was under the waterfall. From behind the waterfall, face east and walk straight, jump off the cliffs and keep following the river down until you get to a cute rock stack and a camera on your right. The Brain in a Jar is leaning against the large rock next to the rock stack. What is it meant to be? A bird?",
  "n_when_written": 5
 },
