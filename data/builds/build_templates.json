{
  "_README": "HAND-KEPT input for the Builds category. build_builds_json.py validates it and copies it to dist/builds/build_templates.json; problems (a card / weapon / effect name that doesn't exist in the game data) are printed by the build and listed under 'problems' in the output. Everything else the calculator picks from is generated from the game files. Sections: rules (game numbers + how much each playstyle cares about each tag), perkTagOverrides / effectTagOverrides (fix what the auto-tagger gets wrong), armourSets (set notes the files don't carry), mutations (what each mutation is good / bad for), templates (one per preset page).",

  "rules": {
    "_note": "Perk-coin rank-up costs, legendary perk slot levels and the Legendary SPECIAL bonuses are NOT kept here: build_builds_json.py reads them from the game records (CURV LegendaryPerks_Upgrades, CURV LegendaryPerkSlotCount, SPEL AbLgnPerk<Stat>) every build. specialStart / specialCap / pointsCapLevel are the character-sheet rules (1 point in each SPECIAL at the start, 15 max, one point per level to 50).",
    "specialStart": 1,
    "specialCap": 15,
    "pointsCapLevel": 50,
    "bnbOrderUrl": "#bnb-order-link-placeholder",

    "focus": {
      "_note": "How much each playstyle wants each tag. A card / effect / mod scores the sum of the weights of its tags. Weapon-class tags (heavy, rifle, melee...) are handled separately: a card tagged for a weapon class you don't use is never picked.",
      "damage":  { "damage": 10, "armorpen": 8, "debuff": 7, "crit": 4, "killstreak": 5, "ap": 3, "heal": 2, "defense": 2, "reload": 2, "accuracy": 2, "stagger": 1, "limb": 1, "bleed": 2, "carry": 1 },
      "balanced": { "damage": 7, "armorpen": 5, "debuff": 5, "crit": 3, "killstreak": 3, "ap": 4, "heal": 6, "defense": 7, "reload": 2, "accuracy": 2, "carry": 3, "speed": 2, "survival": 1 },
      "farmer":  { "damage": 4, "armorpen": 3, "defense": 4, "heal": 4, "carry": 9, "farm": 10, "craft": 6, "survival": 3, "xp": 4, "speed": 2, "ap": 2 },
      "team":    { "damage": 6, "armorpen": 4, "debuff": 8, "defense": 7, "heal": 7, "team": 9, "ap": 3, "survival": 2, "carry": 2 }
    },
    "aimWeights": {
      "vats":    { "vats": 7, "crit": 6, "ap": 5, "nonvats": -9 },
      "free":    { "nonvats": 6, "accuracy": 3, "reload": 2, "vats": -9 },
      "sneak":   { "sneak": 9, "silenced": 6, "crit": 2, "vats": 2 }
    },
    "carryWeights": { "carry": 8 },
    "utilityWeights": { "lockpick": 4, "hack": 4 },
    "statValue": {
      "_note": "Value of one raw SPECIAL point on its own (before any card sits on it), per tag the build wants. Keeps spare points going to the stat that helps most.",
      "S": { "melee": 1.2, "unarmed": 1.2, "carry": 0.8, "heavy": 0.3 },
      "P": { "vats": 0.8, "rifle": 0.3 },
      "E": { "heal": 0.6, "defense": 0.4 },
      "C": { "team": 0.6, "solo": 0.5 },
      "I": { "energy": 0.5, "craft": 0.4, "xp": 0.3 },
      "A": { "ap": 0.7, "sneak": 0.7, "vats": 0.5 },
      "L": { "crit": 0.8, "vats": 0.5, "farm": 0.4 }
    }
  },

