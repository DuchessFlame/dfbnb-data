{
  "_notes": {
    "purpose": "Season Ticket Calculator data for TheDuchessFlame.com. Used by df-bnb-df-calculator.js (mountSeasonTickets).",
    "how_to_update_each_season": [
      "1. Update 'seasonNumber' to the new season number (e.g. 25).",
      "2. Update 'seasonName' to the new season name (e.g. 'New Season Name').",
      "3. Update 'unlockRequiredCount' — the number of items a player must claim to unlock Bonus Page 2.",
      "4. Update 'unlockRankRequired' — the rank the player must reach to unlock Bonus Page 2.",
      "5. Update 'unlockLineText' — the human-readable string shown for the unlock requirement.",
      "6. WIPE the 'items' array and replace with all items from the new season.",
      "7. For each item, follow the item schema below. Add 'tallyCategory' to any item that matches a tally category.",
      "8. IDs must follow the pattern: S{seasonNum}_P{pageNum}_{snake_case_name} for regular pages, S{seasonNum}_B{bonusPageNum}_{snake_case_name} for bonus pages.",
      "9. Pages are '1' through '10' for regular pages, 'B1' for Bonus Page 1, 'B2' for Bonus Page 2.",
      "10. The tally table in the calculator counts items from pages 1-10 and B1 only. B2 is intentionally EXCLUDED from the tally.",
      "11. Even though B2 items are excluded from the tally display, still add tallyCategory to B2 items for data completeness."
    ],
    "item_schema": {
      "id": "STRING - Unique ID. Pattern: S{seasonNum}_P{pageNum}_{snake_name} or S{seasonNum}_B{bonusNum}_{snake_name}",
      "page": "STRING - Page number. Use '1'-'10' for regular pages, 'B1' for Bonus Page 1, 'B2' for Bonus Page 2.",
      "name": "STRING - Display name shown in the calculator.",
      "cost": "NUMBER - Ticket cost (0 if free).",
      "isFirst": "BOOLEAN (optional) - Set true if this item is exclusive to Fallout First members. When the user has NOT toggled 'Fallout First Member' on, these items are hidden and excluded from all counts.",
      "tallyCategory": "STRING (optional) - Category key for the utility tally table shown below 'Total Ticket Cost'. See valid values below.",
      "kind": "STRING (optional) - Used for titles/icons: 'playerIcon', 'campTitlePrefix', 'campTitleSuffix', 'playerTitlePrefix', 'playerTitleSuffix', 'playerTitlePrefixSuffix'.",
      "value": "STRING (optional) - The title/icon label value when 'kind' is set.",
      "storefrontEntitlement": "STRING (optional) - Internal Bethesda entitlement code.",
      "imageUrl": "STRING (optional) - URL to item image.",
      "description": "STRING (optional) - Item description shown in expanded detail panel."
    },
    "tally_category_valid_values": {
      "atoms": "Atoms",
      "camp_player_title": "Camp & Player Titles (includes all CAMP title prefixes/suffixes and player title prefixes/suffixes)",
      "caps": "Caps",
      "carry_weight_booster": "Carry Weight Booster",
      "gold_bullion": "Gold Bullion",
      "improved_bait": "Improved Bait",
      "legendary_module": "Legendary Module",
      "legendary_scrip": "Legendary Scrip",
      "lunchbox": "Lunchbox",
      "mystery_bobblehead": "Mystery Bobblehead",
      "mystery_magazine": "Mystery Magazine",
      "nuclear_keycard": "Nuclear Keycard",
      "nukashine": "Nukashine",
      "perk_coins": "Perk Coins",
      "player_icon": "Player Icon",
      "re_roller": "Re-Roller",
      "repair_kit": "Repair Kits",
      "score_booster": "S.C.O.R.E. Boosters (includes any S.C.O.R.E. Boost % items)",
      "scouts_banner": "Scout's Banner",
      "stamps": "Stamps",
      "superb_bait": "Superb Bait"
    },
    "tally_behaviour": "The tally table in the JS counts how many items in the visible list (respecting the Fallout First toggle) have each tallyCategory, excluding Bonus Page 2 items. It counts occurrences (line items), NOT quantities. Counts update live as the user toggles 'Fallout First Member'.",
    "js_file": "df-bnb-df-calculator.js — see mountSeasonTickets() and the TALLY_DISPLAY constant.",
    "css_file": "df-bnb-df-calculator.css — tally table uses dfcalcTallyTable and dfcalcTallyRow classes."
  },
