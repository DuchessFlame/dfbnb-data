      "region": "Burning Springs",
      "locations": [
        {
          "marker": "Dino Peaks Mini Golf",
          "count": 4,
          "note": "I would run ahead and clear the area, then fast travel back to Dino Peaks Mini Golf to put you back at the spawn-in location — it makes it easier to follow the directions to each corpse.",
          "spawns": [
            {
              "label": "Spawn 1",
              "image_top": "/wp-content/uploads/guide-images/collectables/Slasher-Mask-Locations/burning-springs-dino-peaks-mini-golf-1-map.avif",
              "directions": "From the spawn-in location, face north and run forward, under the Dino Peaks sign, and then turn left. Follow the path around, going past hole 1. Go up the ramp and head towards the headless dinosaur at hole 3. The phantom's corpse will be on the second bench on your left.",
              "image_bottom": "/wp-content/uploads/guide-images/collectables/Slasher-Mask-Locations/burning-springs-dino-peaks-mini-golf-1-item.avif"
            },
            {
              "label": "Spawn 2",
              "image_top": "/wp-content/uploads/guide-images/collectables/Slasher-Mask-Locations/burning-springs-dino-peaks-mini-golf-2-map.avif",
              "directions": "From Spawn 1, go back to the hole 3 sign and face north. Walk forward towards the white shed at the back, and the phantom's corpse will be on the ground near the main entrance, inside the dinosaur jaw.",
              "image_bottom": "/wp-content/uploads/guide-images/collectables/Slasher-Mask-Locations/burning-springs-dino-peaks-mini-golf-2-item.avif"
            },
            {
              "label": "Spawn 3",
              "image_top": "/wp-content/uploads/guide-images/collectables/Slasher-Mask-Locations/burning-springs-dino-peaks-mini-golf-3-map.avif",
              "directions": "From Spawn 2, face south and walk forward until you reach the picnic table with the radio on it. Face east and follow the path up the ramp and around to the right until you get to hole 4. Face south and follow hole 4 to the end, then keep walking straight until you get to the jeep on the edge of the cliff. The phantom's corpse is inside the jeep.",
              "image_bottom": "/wp-content/uploads/guide-images/collectables/Slasher-Mask-Locations/burning-springs-dino-peaks-mini-golf-3-item.avif"
