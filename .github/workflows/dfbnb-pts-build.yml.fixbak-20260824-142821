      # --- PATCH LOG FEEDS (PTS) ---
      # Reads tsv/pts/ directly, NOT the normalized tsv/ tree. normalize_pts_tsv
      # keeps only the newest pull per record type, so the normalized tree has one
      # file each and there is nothing to diff. tsv/pts/ still holds every
      # timestamped pull, which is exactly the per-upload history the PTS toggle
      # should show — several entries in a busy fortnight, none in a quiet month.
      - name: Build patch log feeds (export diffs, PTS)
        run: python src/patchlog_utils.py --write-feeds --dist dist --channel pts

      # --- RELOCATE TO dist/pts AND COMMIT (PTS channel) ---
      - name: Relocate build output into dist/pts
        shell: bash
        run: |
          shopt -s extglob dotglob
          mkdir -p dist/pts
          for item in dist/!(pts); do
            mv "$item" dist/pts/
          done
          echo "dist/pts now contains:"; ls -1 dist/pts | head -50

      - name: Generate PTS vs Live changelog
        shell: bash
        run: |
          # Restore live dist/ (from HEAD) so we can diff the two channels — but
          # EXCLUDE dist/pts. A plain `git checkout HEAD -- dist` also reverts the
          # freshly-relocated dist/pts back to the committed (stale) version, so the
          # commit step below then sees no diff ("No PTS changes to commit") and the
          # PTS channel never updates. The exclude pathspec keeps the fresh build.
          git checkout HEAD -- dist ':(exclude)dist/pts' 2>/dev/null || true
          python src/diff_live_pts.py --live dist --pts dist/pts --json || true

      - name: Commit & Push (dist/pts only)
        shell: bash
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions@users.noreply.github.com"

          # Stage ONLY dist/pts. This run overwrote tsv/ and cleared dist/ in the
          # ephemeral checkout; commit dist/pts, then discard everything else so
          # the rebase/push stays clean and live tsv/ + dist/ are untouched.
          git add dist/pts
          if git diff --cached --quiet; then
            echo "No PTS changes to commit."
          else
            git commit -m "DFBNB PTS Build update" -- dist/pts
            git checkout -- . 2>/dev/null || true
            git clean -fd tsv dist 2>/dev/null || true
            # Land on top of a moving main. Regenerated-JSON conflicts resolve in
            # favour of THIS build's output (-X theirs = the commit being replayed),
            # and we retry to survive a push race with the live patch build.
            pushed=0
            for attempt in 1 2 3 4 5; do
              git fetch origin main
              if git pull --rebase -X theirs origin main; then
                if git push origin main; then pushed=1; break; fi
              else
                git rebase --abort 2>/dev/null || true
              fi
              echo "push race, retry $attempt"; sleep $((RANDOM % 6 + 3))
            done
            [ "$pushed" = 1 ] || { echo "ERROR: could not push dist/pts after retries"; exit 1; }
          fi
