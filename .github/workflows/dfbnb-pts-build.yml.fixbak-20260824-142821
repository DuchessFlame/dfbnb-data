name: DFBNB PTS Build

# Builds the PTS (public test server) data channel into dist/pts/.
# This MIRRORS dfbnb-patch-build.yml step-for-step on purpose.
#
# >>> SYNC NOTE <<<
# When you add / remove / reorder a build step in dfbnb-patch-build.yml,
# make the SAME change here. The ONLY intended differences are:
#   * triggers on tsv/pts/** (not tsv/**)
#   * a "Normalize PTS TSV" + "Clear dist" step before the builds
#   * the final steps relocate dist/ -> dist/pts/ and commit ONLY dist/pts/
# Live dist/ and tsv/ are never modified by this workflow.

on:
  workflow_dispatch:
  schedule:
    - cron: '0 */12 * * *'        # midnight & noon UTC
  push:
    branches: [ main ]
    paths:
      - "tsv/pts/**"
      - "src/**"
      - "tools/**"
      - ".github/workflows/dfbnb-pts-build.yml"

permissions:
  contents: write

concurrency:
  group: dist-pts
  cancel-in-progress: false
jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout (full history)
        uses: actions/checkout@v5
        with:
          fetch-depth: 0

      - name: Setup Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.11"

      - name: Setup Node
        uses: actions/setup-node@v5
        with:
          node-version: "24"

      - name: Install Python dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pandas

      # Same guard as the live build — see dfbnb-patch-build.yml.
      - name: Verify export selection (tsv_source lint)
        run: python src/tsv_source.py --lint

      # ===== PTS CHANNEL SETUP =====
      # Overwrite the dated exports in the (ephemeral) tsv/ checkout with the
      # newest PTS pull, normalized to live-style names so every downstream
      # builder works unchanged. Then wipe dist/ so whatever remains after the
      # build is PURE PTS output (no leftover live files).
      - name: Normalize PTS TSV into tsv/
        run: python src/normalize_pts_tsv.py --src tsv/pts --dst tsv --in-place

      - name: Clear dist for a clean PTS build
        run: rm -rf dist && mkdir -p dist

      # ===== DROP RATES (must run before titles, events) =====
      - name: Build Drop Rates JSON
        run: python src/build_drop_rates.py

      - name: Sanity check drop_rates.json
        run: |
          test -f dist/drop_rates.json && echo "OK drop_rates.json ($(wc -c < dist/drop_rates.json) bytes)" || (echo "MISSING drop_rates.json" && exit 1)

      # --- TITLES ---
      - name: Build Titles JSON
        run: |
          python src/build_titles_json.py \
            --tsv-root tsv \
            --seasons tsv/fallout76_seasons.tsv \
            --outdir dist

      - name: Stage patchlog latest (titles -> generic)
        run: cp dist/titles_patchlog.json dist/patchlog_latest_titles.json

      - name: Build patchlog manifest (from guide_index.tsv)
        run: |
          python src/build_patchlog_manifest_from_guide_index.py \
            --guide-index tsv/guide_index.tsv \
            --out dist/patchlog_manifest.json \
            --dist-base-url "https://raw.githubusercontent.com/${{ github.repository }}/${{ github.ref_name }}/dist" \
            --titles-feed patchlog_latest_titles.json

      - name: Append patchlog history (append-only)
        run: |
          python src/append_patchlog_history.py \
            --latest dist/patchlog_latest_titles.json \
            --history dist/patchlog_history.json \
            --kind titles

      - name: Build Titles Generator JSON
        run: python src/build_titles_generator_json.py

      - name: Build Camp Titles Manifest
        run: python src/build_titles.py

      # --- CURVES ---

      # Regenerate the POINTS TSV from the committed records TSV +
      # committed curve-table JSONs. This closes the generative loop:
      # once xEdit exports a fresh CURV_Export_*_CURV.tsv, CI rebuilds
      # the matching _POINTS.tsv in-place so downstream builders always
      # see points in lock-step with the records. No "don't forget to
      # run the PowerShell script" step for Duchess to remember.
      #
      # Skip gracefully if no records TSV exists yet — the locate step
      # below will then pick up whatever POINTS file is committed.
      - name: Regenerate CURV POINTS TSV from records + JSONs
        shell: bash
        run: |
          set -e
          # GitHub Actions bash runs with -o pipefail. `ls` given a glob
          # that matches nothing (here: tsv/CURV_Export_*.tsv_CURV.tsv)
          # exits 2 even with stderr redirected, and pipefail propagates
          # that up through the pipe, aborting the script via `set -e`.
          # Wrap ls in `{ ... || true; }` so the pipeline always starts
          # from exit 0; the awk filter decides whether any records TSV
          # was actually found.
          RECORDS=$({ ls -1 tsv/CURV_Export_*_CURV.tsv tsv/CURV_Export_*.tsv_CURV.tsv 2>/dev/null || true; } | awk -F'[_./]' '
            BEGIN {
              m["jan"]=1;m["january"]=1;m["feb"]=2;m["february"]=2;
              m["mar"]=3;m["march"]=3;m["apr"]=4;m["april"]=4;
              m["may"]=5;m["jun"]=6;m["june"]=6;m["jul"]=7;m["july"]=7;
              m["aug"]=8;m["august"]=8;m["sep"]=9;m["sept"]=9;m["september"]=9;
              m["oct"]=10;m["october"]=10;m["nov"]=11;m["november"]=11;
              m["dec"]=12;m["december"]=12
            }
            { cm=0;cy=0
              for(i=1;i<=NF;i++){v=tolower($i);if(v in m)cm=m[v];if($i~/^[0-9]{4}$/)cy=$i+0}
              printf "%04d%02d %s\n",cy,cm,$0
            }' | sort -k1,1 | tail -n 1 | cut -d' ' -f2-)

          if [ -z "$RECORDS" ]; then
            echo "No CURV records TSV found — skipping regeneration."
            echo "(Downstream steps will use whatever CURV_Export_*_POINTS.tsv is committed.)"
            exit 0
          fi

          if [ ! -d data/curvetables/json ]; then
            echo "data/curvetables/json missing — skipping regeneration."
            echo "(Downstream steps will use the committed CURV_Export_*_POINTS.tsv.)"
            exit 0
          fi

          echo "Using records TSV: $RECORDS"
          python src/build_curv_points_tsv.py \
            --records-tsv "$RECORDS" \
            --json-root data/curvetables/json

      - name: Locate latest CURV points TSV
        shell: bash
        run: |
          # Pick the file whose filename contains the latest Month_Year.
          # On GitHub Actions all mtimes are equal after checkout, so we
          # parse the month name embedded in the filename instead.
          newest_by_name() {
            local files
            files=$(ls -1 $1 2>/dev/null)
            [ -z "$files" ] && return
            echo "$files" | awk -F'[_./]' '
            BEGIN {
              m["jan"]=1;m["january"]=1;m["feb"]=2;m["february"]=2;
              m["mar"]=3;m["march"]=3;m["apr"]=4;m["april"]=4;
              m["may"]=5;m["jun"]=6;m["june"]=6;m["jul"]=7;m["july"]=7;
              m["aug"]=8;m["august"]=8;m["sep"]=9;m["sept"]=9;m["september"]=9;
              m["oct"]=10;m["october"]=10;m["nov"]=11;m["november"]=11;
              m["dec"]=12;m["december"]=12
            }
            { cm=0;cy=0
              for(i=1;i<=NF;i++){v=tolower($i);if(v in m)cm=m[v];if($i~/^[0-9]{4}$/)cy=$i+0}
              printf "%04d%02d %s\n",cy,cm,$0
            }' | sort -k1,1 | tail -n 1 | cut -d' ' -f2-
          }

          FILE=$(newest_by_name "tsv/CURV_Export_*_POINTS.tsv")
          if [ -z "$FILE" ]; then
            echo "ERROR: No CURV_Export_*_POINTS.tsv found in tsv/"
            exit 1
          fi
          echo "CURV_POINTS_TSV=$FILE" >> $GITHUB_ENV
          echo "Using CURV points TSV: $FILE"

          # Same as the live build: the .mjs defaults for these three are literal
          # "March_2026" filenames, so they must be resolved here or the perk-card
          # linkage silently reads March. See dfbnb-patch-build.yml.
          for pair in "PCRD_TSV:tsv/PCRD_Export_*.tsv" \
                      "PERK_TSV:tsv/PERK_Export_*.tsv" \
                      "CURV_HDR_TSV:tsv/CURV_Export_*_CURV.tsv"; do
            var="${pair%%:*}"; pat="${pair#*:}"
            f=$(newest_by_name "$pat")
            if [ -n "$f" ]; then
              echo "$var=$f" >> $GITHUB_ENV
              echo "Using $var: $f"
            else
              echo "WARN: no match for $pat — $var falls back to the builder default"
            fi
          done

      - name: Build Curves JSON
        shell: bash
        run: |
          mkdir -p dist/curves
          CURV_POINTS_TSV="${CURV_POINTS_TSV}" \
          PCRD_TSV="${PCRD_TSV}" \
          PERK_TSV="${PERK_TSV}" \
          CURV_HDR_TSV="${CURV_HDR_TSV}" \
          CURV_OUT_DIR="dist/curves" \
          CURV_CHUNK_MAX_CURVES="200" \
          node tools/build_curves_json.mjs

      # --- EVENTS REWARDS ---
      - name: Build Events Rewards JSON
        run: python src/build_events_rewards_json.py

      # --- ACTIVITIES REWARDS ---
      - name: Build Activities Rewards JSON
        run: python src/build_activities_rewards_json.py

      # --- INFESTATIONS (HTO) REWARDS ---
      - name: Build Infestations (HTO) Rewards JSON
        run: python src/build_hto_rewards_json.py

      # --- INFESTATIONS (HTO) LOCATIONS ---
      # --generative reads LCTN records from tsv/ (PTS-normalized) and extracts
      # locations tagged with LocTypeHostileTakeover, so new/removed PTS
      # locations are picked up automatically. Output goes to dist/infestations/
      # and the relocate step moves it to dist/pts/infestations/.
      - name: Build Infestations (HTO) Locations JSON
        run: python src/build_hto_locations_json.py --generative

      # --- SEASONAL EVENTS REWARDS ---
      - name: Build Seasonal Events Rewards JSON
        run: python src/build_seasonal_events_json.py

      # The flat seasonal_events_rewards.json is legacy static data still consumed
      # by some guide pages. The rewritten builder only emits _by_page.json, so
      # restore the committed flat file from git into the (cleared) dist to keep
      # the PTS channel at parity with live. `git show` reads the blob from the
      # object store even though the Clear dist step wiped the working tree.
      - name: Seed legacy seasonal_events_rewards.json (PTS)
        run: |
          mkdir -p dist/seasonal_events
          git show HEAD:dist/seasonal_events/seasonal_events_rewards.json > dist/seasonal_events/seasonal_events_rewards.json

      # --- RAIDS / EXPOS / DAILY OPS REWARDS ---
      # Each reads dist/events/events_rewards.json (built above) via the shared
      # events_page_pools helper and writes its own per-page dist file. Daily Ops
      # additionally cross-references BOOK + ARMO TSVs to stamp a tradeable flag.
      - name: Build Raids Rewards JSON
        run: python src/build_raids_json.py

      - name: Build Expos Rewards JSON
        run: python src/build_expos_json.py

      - name: Build Daily Ops JSON
        run: python src/build_daily_ops_json.py

      # --- BOUNTY HUNTING CHALLENGES (reads CHAL TSV directly) ---
      - name: Build Bounty Hunting Challenges JSON
        run: python src/build_bounty_hunting_json.py

      # --- BOUNTY HUNTING REWARDS (Grunt/Head Hunt reward tree) ---
      # NOTE: not present in dfbnb-patch-build.yml — the live rewards JSON is
      # built by its own workflow (build-bounty-hunting-rewards.yml). We add it
      # here so the PTS channel produces dist/pts/bounty-hunting/. DFBNB_CHANNEL=pts
      # surfaces the seasonal Slasher party-crasher group in the PTS preview even
      # while the live Head Hunt toggle is still off.
      - name: Build Bounty Hunting Rewards JSON
        env:
          DFBNB_CHANNEL: pts
        run: python src/build_bounty_hunting_rewards_json.py

      # Head Hunt boss groups (lifetime-challenge checklist). Built here on the
      # PTS channel so dist/pts/bounty-hunting/head_hunt_bosses.json includes the
      # seasonal Slasher party-crasher group while the live toggle is still off.
      - name: Build Head Hunt Bosses JSON
        env:
          DFBNB_CHANNEL: pts
        run: python src/build_head_hunt_bosses_json.py

      # --- MINI SEASONS ---
      - name: Build Mini Seasons JSON
        run: python src/build_mini_seasons_json.py

      # --- CHALLENGES ---
      - name: Build Challenges JSON
        run: python src/build_challenges_json_v3.py

      # --- DAILY PIP-BOY QUESTS ---
      - name: Build Daily Quests JSON
        run: python src/build_daily_quests_json.py

      # --- CHAL LATEST / PREVIOUS ---
      - name: Build CHAL Latest/Previous JSON
        run: python src/build_chal_latest_previous.py

      # --- DF CALCULATORS ---
      - name: Pick newest TSVs (DF Calculators)
        shell: bash
        run: |
          set -e

          newest() {
            local files
            files=$(ls -1 $1 2>/dev/null)
            [ -z "$files" ] && return
            echo "$files" | awk -F'[_./]' '
            BEGIN {
              m["jan"]=1;m["january"]=1;m["feb"]=2;m["february"]=2;
              m["mar"]=3;m["march"]=3;m["apr"]=4;m["april"]=4;
              m["may"]=5;m["jun"]=6;m["june"]=6;m["jul"]=7;m["july"]=7;
              m["aug"]=8;m["august"]=8;m["sep"]=9;m["sept"]=9;m["september"]=9;
              m["oct"]=10;m["october"]=10;m["nov"]=11;m["november"]=11;
              m["dec"]=12;m["december"]=12
            }
            { cm=0;cy=0
              for(i=1;i<=NF;i++){v=tolower($i);if(v in m)cm=m[v];if($i~/^[0-9]{4}$/)cy=$i+0}
              printf "%04d%02d %s\n",cy,cm,$0
            }' | sort -k1,1 | tail -n 1 | cut -d' ' -f2-
          }

          FLST_ENTRIES_TSV="$(newest "tsv/FLST_Export_*_Entries.tsv")"
          ARMO_TSV="$(newest "tsv/ARMO_Export_*.tsv")"
          ENTM_TSV="$(newest "tsv/ENTM_Export_*.tsv")"
          COBJ_TSV="$(newest "tsv/COBJ_Export_*.tsv")"
          FURN_TSV="$(newest "tsv/FURN_Export_*_FURN.tsv")"

          if [ -z "$FLST_ENTRIES_TSV" ]; then echo "Missing FLST Entries TSV (tsv/FLST_Export_*_Entries.tsv)"; exit 1; fi
          if [ -z "$ARMO_TSV" ]; then echo "Missing ARMO TSV (tsv/ARMO_Export_*.tsv)"; exit 1; fi
          if [ -z "$COBJ_TSV" ]; then echo "Missing COBJ TSV (tsv/COBJ_Export_*.tsv)"; exit 1; fi
          if [ -z "$FURN_TSV" ]; then echo "Missing FURN TSV (tsv/FURN_Export_*_FURN.tsv)"; exit 1; fi

          echo "FLST_ENTRIES_TSV=$FLST_ENTRIES_TSV" >> $GITHUB_ENV
          echo "ARMO_BOD2_TSV=$ARMO_TSV" >> $GITHUB_ENV
          echo "ENTM_TSV=$ENTM_TSV" >> $GITHUB_ENV
          echo "COBJ_TSV=$COBJ_TSV" >> $GITHUB_ENV
          echo "FURN_TSV=$FURN_TSV" >> $GITHUB_ENV

          echo "Using:"
          echo "  FLST_ENTRIES_TSV=$FLST_ENTRIES_TSV"
          echo "  ARMO_BOD2_TSV=$ARMO_TSV"
          echo "  ENTM_TSV=$ENTM_TSV"
          echo "  COBJ_TSV=$COBJ_TSV"
          echo "  FURN_TSV=$FURN_TSV"

      - name: Build DF Calculators JSON
        run: node tools/build_df_calculators_json.mjs
        env:
          FLST_ENTRIES_TSV: ${{ env.FLST_ENTRIES_TSV }}
          ARMO_BOD2_TSV: ${{ env.ARMO_BOD2_TSV }}
          ENTM_TSV: ${{ env.ENTM_TSV }}
          COBJ_TSV: ${{ env.COBJ_TSV }}
          OUT_DIR: dist/calculators

      - name: Stage DF calculators patchlog feeds
        # build_df_calculators_json.mjs writes per-page patchlog feeds next to
        # the data files. Copy them into dist/ with the names the patchlog
        # manifest expects so the build-inspiration page and the
        # outfit-inspiration page each get their own, separate feed.
        run: |
          cp dist/calculators/build_inspiration_patchlog.json  dist/patchlog_latest_df_build_inspiration.json
          cp dist/calculators/outfit_inspiration_patchlog.json dist/patchlog_latest_df_outfit_inspiration.json

      - name: Build Weapon Spin Wheel JSON (PTS)
        run: python src/build_spin_wheel_json.py --pts

      # --- DF SCOREBOARDS (placeholder patchlog) ---
      - name: Stage scoreboards patchlog feed (placeholder)
        # No dedicated builder for the scoreboards category yet — the Season
        # Ticket Calculator and S.C.O.R.E. Progression Calculator pages live
        # under /df/scoreboards/ but their underlying season-ticket reward and
        # SCORE challenge data isn't diffed into a patchlog yet. Emit a
        # minimal valid stub so the patchlog manifest URL resolves (no 404)
        # and the patchlog UI on those pages just shows "no recent changes".
        # When real change tracking is wired up (e.g. extend
        # build_score_challenges_json.py / build_seasons_json.py to emit a
        # scoreboards_patchlog.json), replace this step with a `cp` from the
        # builder output, same pattern as the DF calculators step above.
        run: |
          TS=$(date -u +%FT%T+00:00)
          cat > dist/patchlog_latest_df_scoreboards.json <<EOF
          {
            "entries": [
              {
                "ts": "${TS}",
                "current": 0,
                "added": [],
                "removed": [],
                "changed": []
              }
            ]
          }
          EOF

      # --- ARMOUR DATA ---
      - name: Build Armour Data JSON
        run: python src/build_armour_json.py --data-dir tsv --out dist/armour.json

      # --- COLLECTABLES ---
      # Seed the live collectables_notes.json so the PTS build can compute
      # isPtsNew (items in PTS but not in live). `git show` reads from the
      # object store — safe even though dist/ was cleared.
      - name: Seed live collectables_notes.json for PTS comparison
        run: |
          mkdir -p /tmp/live-dist
          git show HEAD:dist/collectables_notes.json > /tmp/live-dist/collectables_notes.json 2>/dev/null || true

      - name: Build Collectables JSON
        run: |
          python src/build_collectables_json.py \
            --tsv-root tsv \
            --seasons tsv/fallout76_seasons.tsv \
            --outdir dist \
            --live-dist /tmp/live-dist

      # --- CAMP ITEMS ---
      - name: Build Camp Items JSON
        run: |
          python src/build_camp_items_json.py \
            --tsv-root tsv \
            --outdir dist

      # --- PLAN CHECKLISTS (How to Obtain) ---
      # Writes dist/plan_master.json from the PTS tsvs; the relocate step below
      # moves it to dist/pts/plan_master.json for the PTS plan-checklist pages.
      - name: Build Plan Checklists (How to Obtain) JSON
        run: |
          python src/build_plan_obtain_json.py \
            --data-dir tsv \
            --outdir dist \
            --report dist/plan_master_unresolved.json

      # --- VENDORS (must run before Allies — ally inventory reads vendor data) ---
      - name: Build Vendors JSON
        run: python src/build_vendors_json.py

      # --- ALLIES · PETS · WEATHER · CRYOS · REPAIR BOTS ---
      - name: Pick BOOK TSV (Allies/Pets/Weather)
        shell: bash
        run: |
          newest_by_name() {
            local files
            files=$(ls -1 $1 2>/dev/null)
            [ -z "$files" ] && return
            echo "$files" | awk -F'[_./]' '
            BEGIN {
              m["jan"]=1;m["january"]=1;m["feb"]=2;m["february"]=2;
              m["mar"]=3;m["march"]=3;m["apr"]=4;m["april"]=4;
              m["may"]=5;m["jun"]=6;m["june"]=6;m["jul"]=7;m["july"]=7;
              m["aug"]=8;m["august"]=8;m["sep"]=9;m["sept"]=9;m["september"]=9;
              m["oct"]=10;m["october"]=10;m["nov"]=11;m["november"]=11;
              m["dec"]=12;m["december"]=12
            }
            { cm=0;cy=0
              for(i=1;i<=NF;i++){v=tolower($i);if(v in m)cm=m[v];if($i~/^[0-9]{4}$/)cy=$i+0}
              printf "%04d%02d %s\n",cy,cm,$0
            }' | sort -k1,1 | tail -n 1 | cut -d' ' -f2-
          }
          BOOK=$(ls tsv/BOOK_Export_*.tsv 2>/dev/null | grep -iv '_locations' | awk -F'[_./]' '
            BEGIN {
              m["jan"]=1;m["january"]=1;m["feb"]=2;m["february"]=2;
              m["mar"]=3;m["march"]=3;m["apr"]=4;m["april"]=4;
              m["may"]=5;m["jun"]=6;m["june"]=6;m["jul"]=7;m["july"]=7;
              m["aug"]=8;m["august"]=8;m["sep"]=9;m["sept"]=9;m["september"]=9;
              m["oct"]=10;m["october"]=10;m["nov"]=11;m["november"]=11;
              m["dec"]=12;m["december"]=12
            }
            { cm=0;cy=0
              for(i=1;i<=NF;i++){v=tolower($i);if(v in m)cm=m[v];if($i~/^[0-9]{4}$/)cy=$i+0}
              printf "%04d%02d %s\n",cy,cm,$0
            }' | sort -k1,1 | tail -n 1 | cut -d' ' -f2-)
          if [ -z "$BOOK" ]; then echo "ERROR: No BOOK_Export_*.tsv (non-Locations) found in tsv/"; exit 1; fi
          echo "BOOK_TSV=$BOOK" >> $GITHUB_ENV
          echo "Using BOOK TSV: $BOOK"

      # --- MINERVA PLANS ---
      # Folded in from dfbnb-minerva-build.yml — uses the BOOK_TSV env var
      # set by "Pick BOOK TSV" above.
      - name: Build Minerva Plans JSON
        shell: bash
        run: |
          mkdir -p dist/minerva
          python src/build_minerva.py "$BOOK_TSV" > dist/minerva/minerva_plans.json
          echo "Built dist/minerva/minerva_plans.json"

      - name: Sanity check Minerva output
        run: |
          test -f dist/minerva/minerva_plans.json \
            && echo "OK minerva_plans.json" \
            || (echo "MISSING minerva_plans.json" && exit 1)
          python3 -c "
          import json, sys
          d = json.load(open('dist/minerva/minerva_plans.json'))
          assert 'minerva' in d, 'Missing minerva key'
          assert 'all_plans' in d, 'Missing all_plans key'
          assert len(d['minerva']) > 0, 'minerva list is empty'
          assert len(d['all_plans']) > 0, 'all_plans list is empty'
          print(f'  Minerva plans: {len(d[\"minerva\"])}')
          print(f'  All gold vendor plans: {len(d[\"all_plans\"])}')
          "

      - name: Pick TSVs (Allies extras + Buff Stations)
        shell: bash
        run: |
          # Month-aware picker — plain sorted() globs put May after June
          # alphabetically, so these MUST be picked by month/year.
          newest_by_name() {
            local files
            files=$(ls -1 $1 2>/dev/null)
            [ -z "$files" ] && return
            echo "$files" | awk -F'[_./]' '
            BEGIN {
              m["jan"]=1;m["january"]=1;m["feb"]=2;m["february"]=2;
              m["mar"]=3;m["march"]=3;m["apr"]=4;m["april"]=4;
              m["may"]=5;m["jun"]=6;m["june"]=6;m["jul"]=7;m["july"]=7;
              m["aug"]=8;m["august"]=8;m["sep"]=9;m["sept"]=9;m["september"]=9;
              m["oct"]=10;m["october"]=10;m["nov"]=11;m["november"]=11;
              m["dec"]=12;m["december"]=12
            }
            { cm=0;cy=0
              for(i=1;i<=NF;i++){v=tolower($i);if(v in m)cm=m[v];if($i~/^[0-9]{4}$/)cy=$i+0}
              printf "%04d%02d %s\n",cy,cm,$0
            }' | sort -k1,1 | tail -n 1 | cut -d' ' -f2-
          }
          ACTI=$(newest_by_name "tsv/ACTI_Export_*_ACTI.tsv")
          WTHR=$(newest_by_name "tsv/WTHR_Export_*_WTHR.tsv")
          NPCP=$(newest_by_name "tsv/NPC_Export_*_PRPS.tsv")
          KYWD=$(newest_by_name "tsv/KYWD_Export_*_Refs.tsv")
          PERK=$(newest_by_name "tsv/PERK_Export_*.tsv")
          echo "ACTI_TSV=$ACTI"      >> $GITHUB_ENV
          echo "WTHR_TSV=$WTHR"      >> $GITHUB_ENV
          echo "NPC_PRPS_TSV=$NPCP"  >> $GITHUB_ENV
          echo "KYWD_REFS_TSV=$KYWD" >> $GITHUB_ENV
          echo "PERK_TSV=$PERK"      >> $GITHUB_ENV
          echo "  ACTI: $ACTI"; echo "  WTHR: $WTHR"; echo "  NPC PRPS: $NPCP"
          echo "  KYWD Refs: $KYWD"; echo "  PERK: $PERK"

      - name: Build Allies / Pets / Weather JSON
        run: |
          python src/build_allies_pets_weather_json.py \
            --tsv-dir tsv \
            --out-dir dist
        env:
          COBJ_TSV:         ${{ env.COBJ_TSV }}
          ENTM_TSV:         ${{ env.ENTM_TSV }}
          FURN_TSV:         ${{ env.FURN_TSV }}
          FLST_ENTRIES_TSV: ${{ env.FLST_ENTRIES_TSV }}
          BOOK_TSV:         ${{ env.BOOK_TSV }}
          ACTI_TSV:         ${{ env.ACTI_TSV }}
          WTHR_TSV:         ${{ env.WTHR_TSV }}
          NPC_PRPS_TSV:     ${{ env.NPC_PRPS_TSV }}

      # --- BUFF STATIONS (auto-discovers from buff-furniture keywords) ---
      - name: Build Buff Stations JSON
        run: |
          python src/build_buff_stations_json.py \
            --tsv-dir tsv \
            --out-dir dist
        env:
          FURN_TSV:      ${{ env.FURN_TSV }}
          ACTI_TSV:      ${{ env.ACTI_TSV }}
          ENTM_TSV:      ${{ env.ENTM_TSV }}
          KYWD_REFS_TSV: ${{ env.KYWD_REFS_TSV }}
          PERK_TSV:      ${{ env.PERK_TSV }}
          COBJ_TSV:      ${{ env.COBJ_TSV }}

      # --- PLAN MASTER ---
      - name: Build Plan Master JSON
        run: |
          mkdir -p dist
          node src/plan-system/build-plan-master.mjs

      # --- AXOLOTL ---
      - name: Build Axolotl Rotations JSON
        run: node tools/build-axolotl-rotations-json.mjs

      # --- SEASONAL FISH ---
      # Reads the latest FISH + LVLI_Entries TSVs and emits dist/seasonal-fish.json
      # consumed by the home banner. Regenerative — if Bethesda moves a fish
      # between regional collections or adds a new seasonal fish, the next build
      # picks it up without code changes. Runs AFTER Axolotl for consistency.
      - name: Build Seasonal Fish JSON
        run: node tools/build-seasonal-fish-json.mjs

      # --- HOME EVENTS ---
      - name: Build Home Events JSON
        run: node tools/build-home-events-json.mjs

      # --- BUNDLES ---
      # Extracts bundle items from dist/atom_shop.json into dist/bundles.json
      # for df-bnb-bundles.js. Must run AFTER Build Atom Shop JSON (below).
      # Deferred to after the Atom Shop step — see "Build Bundles JSON" below.

      # ===== GAP-FILLER CATEGORY BUILDS (scaffolded — real logic TBD) =====

      # --- BUFFS ---
      - name: Build Buffs JSON
        run: python src/build_buffs_json.py

      # --- CAMP ---
      - name: Build CAMP JSON
        run: python src/build_camp_json.py

      # --- CRYPTIDS ---
      - name: Build Cryptids JSON
        run: python src/build_cryptids_json.py

      # --- CURRENCY ---
      # BOOK_TSV is already set by the "Pick BOOK TSV (Allies/Pets/Weather)" step above.
      # build_currency_json.py reads the BOOK TSV directly — no minerva dependency.
      - name: Build Currency JSON
        shell: bash
        run: |
          LVLI=$(ls -1 tsv/LVLI_Export_*_LVLI_Entries.tsv 2>/dev/null | awk -F'[_./]' '
            BEGIN {
              m["jan"]=1;m["january"]=1;m["feb"]=2;m["february"]=2;
              m["mar"]=3;m["march"]=3;m["apr"]=4;m["april"]=4;
              m["may"]=5;m["jun"]=6;m["june"]=6;m["jul"]=7;m["july"]=7;
              m["aug"]=8;m["august"]=8;m["sep"]=9;m["sept"]=9;m["september"]=9;
              m["oct"]=10;m["october"]=10;m["nov"]=11;m["november"]=11;
              m["dec"]=12;m["december"]=12
            }
            { cm=0;cy=0
              for(i=1;i<=NF;i++){v=tolower($i);if(v in m)cm=m[v];if($i~/^[0-9]{4}$/)cy=$i+0}
              printf "%04d%02d %s\n",cy,cm,$0
            }' | sort -k1,1 | tail -n 1 | cut -d' ' -f2-)
          python src/build_currency_json.py \
            --book-tsv "$BOOK_TSV" \
            ${LVLI:+--lvli-entries "$LVLI"} \
            --outdir dist

      # --- DATA MINING ---
      - name: Build Data Mining JSON
        run: python src/build_data_mining_json.py

      # --- EXPERIENCE (XP) ---
      - name: Build Experience JSON
        run: python src/build_experience_json.py

      # --- FARMING (all sub-types) ---
      - name: Build Farming JSON
        run: python src/build_farming_json.py

      - name: Build Farming Consumables JSON
        run: python src/build_farming_consumables_json.py

      - name: Build Farming Critters JSON
        run: python src/build_farming_critters_json.py

      - name: Build Farming Eggs JSON
        run: python src/build_farming_eggs_json.py

      - name: Build Farming Guides JSON
        run: python src/build_farming_guides_json.py

      - name: Build Farming Junk JSON
        run: python src/build_farming_junk_json.py

      - name: Build Farming Meat JSON
        run: python src/build_farming_meat_json.py

      - name: Build Farming Non Perishable JSON
        run: python src/build_farming_non_perishable_json.py

      - name: Build Farming Nuka Cola JSON
        run: python src/build_farming_nuka_cola_json.py

      - name: Build Farming Plants JSON
        run: python src/build_farming_plants_json.py

      # --- LEGENDARY MODS ---
      - name: Build Legendary Mods JSON
        run: python src/build_legendary_mods_json.py

      # --- LEGENDARY CRAFTING PLANNER ---
      # Reads COBJ (shard-crafting + random-roll recipes), resolves ingredient
      # quantities via CURV_POINTS, and looks up display names from OMOD/ALCH/MISC.
      # Outputs dist/legendary_crafting_planner.json for df-bnb-legendary-crafting-planner.js.
      - name: Build Legendary Crafting Planner JSON
        run: python src/build_legendary_crafting_planner_json.py

      # --- LOAD SCREENS ---
      - name: Build Load Screens JSON
        run: python src/build_load_screens_json.py --data-dir tsv --out dist/load_screens.json

      # --- HELP MENU (MESG) ---
      - name: Build Help Menu JSON
        run: python src/build_help_menu_json.py --data-dir tsv --out dist/help_menu.json

      # --- PERK CARDS ---
      - name: Build Perk Cards JSON
        run: python src/build_perk_cards_json.py

      # --- PET TAMING ---
      - name: Build Pet Taming JSON
        run: python src/build_pet_taming_json.py

      # --- SPECIALs & STATS ---
      - name: Build SPECIALs & Stats JSON
        run: python src/build_specials_stats_json.py

      # --- STARFIELD ---
      - name: Build Starfield JSON
        run: python src/build_starfield_json.py

      # --- TREASURE MAPS ---
      - name: Build Treasure Maps JSON
        run: python src/build_treasure_maps_json.py

      # --- WEAPONS ---
      - name: Build Weapons JSON
        run: python src/build_weapons_json.py

      # --- UNIQUE WEAPONS ---
      # Build the single (live) channel into dist/unique_weapons/. In this
      # workflow tsv/ has already been PTS-normalized, so that IS PTS data, and
      # the "Relocate build output into dist/pts" step moves it to
      # dist/pts/unique_weapons/ like every other builder. Do NOT use
      # --channel both here: the pts channel writes straight into dist/pts/
      # unique_weapons/, which then collides with the relocate mv ("Directory
      # not empty"). Output consumed by df-bnb-unique-weapons.js.
      - name: Build Unique Weapons JSON
        run: python src/build_unique_weapons_json.py --channel live

      # --- PENNANTS (Pennants checklist page) ---
      # Outputs dist/pennants.json, served via raw.githubusercontent to
      # df-bnb-plan-checklists.js. Previously had no workflow and went stale.
      - name: Build Pennants JSON
        run: python src/build_pennants_json.py --data-dir tsv --outdir dist

      # --- WORLD PET CHALLENGES (World Pet Challenges page) ---
      # Outputs dist/world_pet_challenges.json for df-bnb-world-pets.js.
      - name: Build World Pet Challenges JSON
        run: python src/build_world_pet_challenges_json.py --tsv-dir tsv --out-dir dist

      # --- WORLD PET TYPES (per-species World Pet pages) ---
      # Outputs dist/world_pet_types.json for df-bnb-world-pets.js.
      # Reads NPC, ENTM, ALCH, ALCH_Effects, COBJ, GLOB TSVs (resolved
      # internally via glob patterns — no explicit env vars needed).
      - name: Build World Pet Types JSON
        run: |
          python src/build_world_pet_types_json.py \
            --tsv-dir tsv \
            --out-dir dist

      # --- WEAK SPOT MULTIPLIERS (BnB calculators) ---
      # Outputs dist/calculators/weak_spot_multipliers.json for df-bnb-bnb-calculators.js.
      - name: Build Weak Spot Multipliers JSON
        run: python src/build_weak_spot_multipliers_json.py

      # --- HEALING CALCULATOR (BnB calculators) ---
      # Outputs dist/calculators/healing_calculator.json for df-bnb-bnb-calculators.js.
      - name: Build Healing Calculator JSON
        run: python src/build_healing_calculator_json.py

      # --- DROP CHANCES DATA (Drop Chances page) ---
      # Outputs dist/drop_chances_data.json for df-bnb-drop-chances.js.
      - name: Build Drop Chances Data JSON
        run: python src/build_drop_chances_data.py --tsv-root tsv --outdir dist

      # --- LEGENDARY MOD DROP CHANCES (Legendary mod calculator) ---
      # Outputs dist/legendary_mod_drop_chances.json for df-bnb-legendary-mod-calc.js.
      - name: Build Legendary Mod Drop Chances JSON
        run: python src/build_legendary_mod_drop_chances_json.py

      # --- NPC SPAWNS (Score Challenges spawn-location pages) ---
      # tools/build_npc_spawns.py outputs dist/npc_spawns.json for df-bnb-npc-spawns.js.
      # The Mappalachia DB is large and local-only, so in CI this runs in CACHE
      # mode: it reads data/npc_spawns/geo_cache.json (committed) for regions +
      # companions and refreshes dig counts + "Used For" from the committed dig
      # .txt and CHAL export every 6h. Regions/companions only change when
      # DuchessFlame re-runs the script locally with the DB and commits a fresh
      # geo_cache.json (which also retriggers this build via the data/** path).
      - name: Build NPC Spawns JSON
        run: python tools/build_npc_spawns.py

      # --- COLLECTABLE SPAWNS ({Item} Spawn Locations pages) ---
      # Same builder as the live channel (CI CACHE mode via data/collectable_spawns/
      # geo_cache.json). dist was wiped for the clean PTS build, so restore the committed
      # copies first: the builder MERGE-preserves hand-filled directions/images per
      # (region, marker), and without the seed those slots would come back empty in PTS.
      # Seeds from live dist/ (hand-fills are authored there); `git show` reads the blob even
      # though the working-tree file was rm -rf'd. || true so a brand-new set with no committed
      # copy yet doesn't fail the run. Add a line here when a new set ships.
      - name: Seed Collectable Spawns JSON from committed copies (PTS)
        run: |
          for f in collectable_spawns_pint-sized-slasher-masks.json; do
            git show "HEAD:dist/$f" > "dist/$f" 2>/dev/null || true
          done

      # Grave placements for the PTS channel. Reads tsv/pts/REFR_Placements_*.tsv and
      # writes tsv/pts/phantom_grave_sites.tsv — never the live file. Coordinates
      # resolve from the committed geo snapshot, so no Mappalachia DB is needed here.
      # See dfbnb-patch-build.yml for the live twin.
      - name: Build Phantom Grave Sites TSV (PTS)
        env:
          DFBNB_CHANNEL: pts
        run: python src/build_phantom_grave_sites_tsv.py --pts || true

      # Dig sites for the PTS channel — writes tsv/pts/, never the live files.
      # See dfbnb-patch-build.yml for the live twins.
      - name: Build Treasure Map Dig Sites TSV (PTS)
        env:
          DFBNB_CHANNEL: pts
        run: python src/build_treasure_map_dig_sites_tsv.py || true

      - name: Build U-Mine-It Dig Sites TSV (PTS)
        env:
          DFBNB_CHANNEL: pts
        run: python src/build_u_mine_it_dig_sites_tsv.py || true

      - name: Build Collectable Spawns JSON
        env:
          DFBNB_CHANNEL: pts
        run: python src/build_collectable_spawns_json.py

      # --- NUKA COLA SPAWNS ({Type} Locations pages) ---
      # Same builder as the live channel, in CI CACHE mode: the full source closure comes from the
      # committed game-file exports and coordinates+regions from data/nuka_cola_spawns/geo_cache.json
      # (no Mappalachia DB in CI). data/ is NOT wiped by the PTS clean, so the cache survives; only
      # dist/ is wiped, so restore the committed dist copies first — the builder MERGE-preserves
      # hand-filled directions/images per (region, marker), and without the seed those slots would
      # come back empty in PTS. Seeds from live dist/ via `git show` (reads the blob even though the
      # working-tree file was rm -rf'd). || true so a brand-new variant with no committed copy yet
      # doesn't fail the run. Add a line to the list when a new variant ships.
      - name: Seed Nuka Cola Spawns JSON from committed copies (PTS)
        run: |
          for f in \
            nuka_cola_spawns_manifest.json \
            nuka_cola_spawns_nuka-cola.json \
            nuka_cola_spawns_nuka-cola-cherry.json \
            nuka_cola_spawns_nuka-cola-cranberry.json \
            nuka_cola_spawns_nuka-cola-dark.json \
            nuka_cola_spawns_nuka-cola-grape.json \
            nuka_cola_spawns_nuka-cola-orange.json \
            nuka_cola_spawns_nuka-cola-quantum.json \
            nuka_cola_spawns_nuka-cola-twist.json \
            nuka_cola_spawns_nuka-cola-vaccinated.json \
            nuka_cola_spawns_nuka-cola-wild.json \
            nuka_cola_spawns_nukashine.json \
            nuka_cola_spawns_sunset-sarsaparilla.json; do
            git show "HEAD:dist/$f" > "dist/$f" 2>/dev/null || true
          done

      - name: Build Nuka Cola Spawns JSON
        run: python src/build_nuka_cola_spawns_json.py

      # --- FARMING SPAWNS (Cream, Deathclaw Egg Spawn Locations pages) ---
      # Same builder as the live channel, in CI CACHE mode. dist/ was wiped for the
      # clean PTS build, so restore the committed copies first — the builder
      # MERGE-preserves hand-filled directions/images per (region, marker), and
      # without the seed those slots would come back empty in PTS. Seeds from live
      # dist/ via `git show`. || true so a first run with no committed copy doesn't fail.
      - name: Seed Farming Spawns JSON from committed copies (PTS)
        run: |
          mkdir -p dist/farming_spawns
          for f in $(git ls-tree --name-only HEAD:dist/farming_spawns/ 2>/dev/null | grep '_spawns\.json$'); do
            git show "HEAD:dist/farming_spawns/$f" > "dist/farming_spawns/$f" 2>/dev/null || true
          done

      - name: Build All Farming Spawns JSON
        run: python src/build_farming_spawns_json.py --all

      # --- CULT OF THE LAMB ---
      - name: Build Cult of the Lamb JSON
        run: python src/build_cult_of_the_lamb_json.py

      # --- COBJ RECIPES (Buffs n Brew crafting data) ---
      - name: Build COBJ Recipes JSON
        run: python src/build_cobj_recipes_json.py

      # --- MENU ITEMS (Buffs n Brew Crafting tab) ---
      # Reads dist/cobj-recipes.json produced by the step above and merges
      # with tsv/menu-overrides.tsv to produce dist/menu-items.json, which
      # is consumed by the staff portal's Crafting tab category classifier.
      # Must run AFTER build_cobj_recipes_json.py.
      - name: Build Menu Items JSON
        run: python src/build_menu_items_json.py

      # --- BNB MENU SYNC (ALCH → menu TSV) ---
      # Reads the latest ALCH_Export_*.tsv + Effects TSV, cross-references
      # with tsv/BnB_Menu_Items.tsv, auto-adds new items that match existing
      # menu categories, and populates mutation/buff columns from ALCH data.
      # Unpriced items are flagged in dist/diagnostics.json for the staff
      # portal diagnose page. Must run BEFORE build_bnb_menu_json.py.
      - name: Sync ALCH into BnB Menu TSV
        run: python src/build_bnb_menu_sync.py

      # --- BNB MENU (public menu page) ---
      # Reads tsv/BnB_Menu_Items.tsv and emits dist/bnb-menu.json — the data
      # source for the Buffs n Brew menu page rendered by df-bnb-menu.js at
      # /bnb/buffs-n-brew/menu/. Self-contained (no COBJ dependency).
      # Must run AFTER build_bnb_menu_sync.py.
      - name: Build BnB Menu JSON
        run: python src/build_bnb_menu_json.py

      # --- BNB ITEM CATEGORIES (ALCH → category index for crafting tab) ---
      # Cross-references ALCH_Export + KYWD_Refs TSVs to classify every
      # consumable into food/canned/nuka_cola/chems/alcohol/serums/prewar_candy.
      # Emits dist/bnb-item-categories.json consumed by the staff portal's
      # Crafting tab to supplement the menu-items.json primary item list.
      - name: Build BnB Item Categories JSON
        run: python src/build_bnb_item_categories_json.py --data-dir tsv --outdir dist

      # --- RECIPE GUIDE (public recipe page at /df/plan-checklists/recipe/) ---
      # Reads dist/farming_guides.json + dist/cobj-recipes.json +
      # dist/bnb-item-categories.json + COBJ TSV refs. Must run AFTER all three
      # upstream builds (farming guides, COBJ recipes, BnB item categories).
      - name: Build Recipe Guide JSON
        run: python src/build_recipe_guide_json.py --data-dir tsv --outdir dist

      # --- FARMING SPAWNS "Used For" (generative) ---
      # PTS reads the PTS-normalised tsv/ + PTS dist/ produced above; the later
      # relocate step moves dist/ -> dist/pts/, so no --pts flag is needed here.
      # Must run AFTER build_farming_spawns_json.py AND build_recipe_guide_json.py.
      - name: Build Farming Spawns "Used For" JSON
        run: python src/build_farming_used_for.py --all

      # --- FISHING ---
      # Reads FISH/GLOB/LVLI TSVs directly and emits dist/fishing.json with
      # fish metadata, spawn rate tables per bait type, axolotl monthly
      # rotation, seasonal fish, waterlogged gifts, and weekend seasonal
      # event data. Self-contained.
      #
      # IMPORTANT: use build_fishing_calculator_json.py (the full builder),
      # NOT build_fishing_json.py — the latter is the legacy script that
      # only emits fish/spawnRates/globs and strips axolotlRotation,
      # seasonalFish, waterloggedGifts, weekendSeasonalFish from the
      # output. The calculator page on the site needs those keys.
      - name: Build Fishing JSON
        run: python src/build_fishing_calculator_json.py

      # --- FISHING EQUIPMENT (rod skins + bobbers & floats) ---
      # Reads OMOD_Export_*.tsv and emits dist/fishing_equipment.json
      # describing every fishing rod skin and bobber/float in the game,
      # classified by how it is obtained (base game / Atomic Shop /
      # Scoreboard season / Mini-Season event / Burning Springs).
      # Consumed by the /df/fishing/fishing-bobbers-floats/ page.
      - name: Build Fishing Equipment JSON
        run: python src/build_fishing_equipment_json.py

      # --- FISHING CHALLENGES CHECKLIST ---
      # Groups the fishing CHAL rows (already selected + leaf-expanded by
      # build_challenges_json_v3.py above) into Daily / Weekly / Big Fish in a
      # Little Pond / Lifetime, resolves rewards (Score + GMRW + overlay), and
      # emits dist/fishing_challenges_checklist.json for the
      # /df/fishing/challenges-checklist/ page. Depends on challenges.json and
      # fishing_big_fish.json, so it runs after both.
      - name: Build Fishing Daily (Big Fish) rewards
        run: python src/build_fishing_daily_rewards_json.py
      - name: Build Fishing Challenges Checklist JSON
        run: python src/build_fishing_challenges_checklist_json.py

      # --- SEASONS ---
      # Reads tsv/fallout76_seasons.tsv and emits dist/seasons.json — the
      # canonical season-number -> {name, dates, etc.} lookup. Consumed by
      # the website wherever "(Season N) Gameboard" labels appear so the
      # JS doesn't have to hardcode a SEASON_NAMES map every patch.
      # Cheap to build; runs before Atom Shop so any future builder that
      # wants to enrich items with season metadata can read it.
      - name: Build Seasons JSON
        run: python src/build_seasons_json.py

      # --- PTS SEASON SCOREBOARD ---
      # Generative builder: discovers SCORE_S{N}_ENTM entries in the
      # ENTM export and produces provisional season_tickets_s{N}.json
      # for seasons that don't yet have curated data in season_rewards.tsv.
      # Safe to run on every build — no-ops when there's nothing new.
      - name: Build PTS Season Scoreboard JSON
        run: python src/build_pts_season_scoreboard.py

      # --- UPCOMING (PTS) REWARDS PREVIEW ---
      # Same SCORE_S{N}_ENTM discovery as the scoreboard builder, but emits the
      # rich A-Z upcoming_rewards_s{N}.json consumed by df-bnb-upcoming-rewards.js
      # on /df/scoreboards/season-{N}/upcoming-rewards/. Only builds seasons that
      # have NOT started yet (skips curated + past seasons); no-ops when there's
      # nothing new. Runs against the PTS ENTM export; the checkout is relocated
      # to dist/pts/ downstream so both dist/ and dist/pts/ carry the file.
      - name: Build Upcoming Rewards JSON
        run: python src/build_upcoming_rewards_json.py

      - name: Verify Upcoming Rewards S26 built
        run: |
          python -c "import json,glob,sys; \
          fs=glob.glob('dist/calculators/upcoming_rewards_s26.json'); \
          d=json.load(open(fs[0])) if fs else {}; \
          n=len(d.get('items',[])); \
          print('[verify] S26 upcoming items:', n); \
          sys.exit(0 if n>0 else 1)"

      # --- ATOM SHOP ---
      # build_atom_shop_json.py is a read-modify-write over dist/atom_shop.json:
      # it reads the committed, curated item list and enriches it in place
      # (image URLs, DESC from the ENTM export, categories, PA applicability).
      # The "Clear dist for a clean PTS build" step above wiped the working-tree
      # copy, so restore the committed seed from git first. `git show` reads the
      # blob from the object store, so this works even though the file was
      # rm -rf'd from the working tree. Live dist/ is never touched -- this only
      # writes into the ephemeral checkout, which is relocated to dist/pts/.
      - name: Seed atom_shop.json from committed copy (PTS)
        run: git show HEAD:dist/atom_shop.json > dist/atom_shop.json

      - name: Build Atom Shop JSON
        run: python src/build_atom_shop_json.py

      # --- BUNDLES (extracted from Atom Shop JSON) ---
      # Filters atom_shop.json for bundle items + LTB bundles → dist/bundles.json
      # for df-bnb-bundles.js (Items Available to Request page).
      - name: Build Bundles JSON
        run: python src/build_bundles_json.py

      # --- SURVIVAL TENT INTERIORS ---
      # Reads the latest tsv/SurvivalTentInteriors_Export_*.tsv (produced
      # by !!!Wordpress - ExportSurvivalTentInteriorsToTSV.pas in xEdit)
      # and emits dist/survival_tent_interiors.json — consumed by the
